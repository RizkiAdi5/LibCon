# Database (Supabase Postgres) — DATABASE_URL lewat pgbouncer (port 6543) untuk app,
# DIRECT_URL koneksi langsung (port 5432) untuk migrasi Prisma.
DATABASE_URL="postgresql://postgres:password@localhost:5432/libcon?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/libcon?schema=public"

# Sesi & token
SESSION_COOKIE_SECRET="ganti-dengan-random-32-byte-hex"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="LibCon <noreply@libcon.example>"

# Aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron (Vercel Cron memanggil endpoint dengan header ini)
CRON_SECRET="ganti-dengan-random-secret"
